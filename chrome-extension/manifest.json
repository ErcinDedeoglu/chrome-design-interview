{
  "manifest_version": 3,
  "name": "UX Feedback Extension",
  "version": "1.0.0",
  "description": "Click DOM elements on demo websites to leave AI-anchored comments and export as JSON.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup/popup.html", "popup/popup.js", "styles/content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}